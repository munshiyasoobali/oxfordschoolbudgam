{
  "entities": {
    "ManagementConfig": {
      "title": "ManagementConfig",
      "description": "Single authorized School Management Google account lock.",
      "type": "object",
      "properties": {
        "adminUid": { "type": "string", "description": "Google Firebase Auth UID of the single Management account." },
        "maskedEmail": { "type": "string", "description": "Masked management Google email for display." },
        "adminName": { "type": "string", "description": "Management display name." },
        "claimedAt": { "type": "string", "format": "date-time", "description": "Server timestamp when claimed." }
      },
      "required": ["adminUid", "maskedEmail", "adminName", "claimedAt"]
    },
    "PaymentAccount": {
      "title": "PaymentAccount",
      "description": "Real school bank and UPI settlement account configured by Management.",
      "type": "object",
      "properties": {
        "accountHolderName": { "type": "string" },
        "upiId": { "type": "string" },
        "bankName": { "type": "string" },
        "accountNumber": { "type": "string" },
        "ifscCode": { "type": "string" },
        "updatedByUid": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["accountHolderName", "upiId", "bankName", "accountNumber", "ifscCode", "updatedByUid", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Parent or Student Google account link to a student Roll Number.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "studentId": { "type": "string" },
        "rollNo": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "studentId", "rollNo", "displayName", "createdAt", "updatedAt"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record in Oxford School Education Budgam.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "grade": { "type": "string" },
        "rollNo": { "type": "string" },
        "parentName": { "type": "string" },
        "contactNumber": { "type": "string" },
        "admissionYear": { "type": "string" },
        "parentUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "grade", "rollNo", "parentName", "contactNumber", "admissionYear", "parentUid", "createdAt", "updatedAt"]
    },
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "30-day monthly attendance register per student.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "parentUid": { "type": "string" },
        "days": { "type": "object", "description": "Map of day '1'..'30' to 'P', 'A', or 'L'." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "parentUid", "days", "updatedAt"]
    },
    "FeeInvoice": {
      "title": "FeeInvoice",
      "description": "Monthly fee invoice denominated in Rs with real UPI/Bank settlement details.",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "rollNo": { "type": "string" },
        "grade": { "type": "string" },
        "parentUid": { "type": "string" },
        "monthLabel": { "type": "string" },
        "tuitionFee": { "type": "integer" },
        "transportFee": { "type": "integer" },
        "examFee": { "type": "integer" },
        "totalAmount": { "type": "integer" },
        "status": { "type": "string", "enum": ["PAID", "PENDING", "OVERDUE"] },
        "receiptNumber": { "type": "string" },
        "paidDate": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "transactionRef": { "type": "string" },
        "payerAccountNote": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentId", "studentName", "rollNo", "grade", "parentUid", "monthLabel", "tuitionFee", "transportFee", "examFee", "totalAmount", "status", "receiptNumber", "paidDate", "paymentMethod", "transactionRef", "payerAccountNote", "createdAt", "updatedAt"]
    },
    "DiaryEntry": {
      "title": "DiaryEntry",
      "description": "School homework assignment or school notice.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "description": { "type": "string" },
        "targetClass": { "type": "string" },
        "dateLabel": { "type": "string" },
        "teacherRemarks": { "type": "string" },
        "entryType": { "type": "string", "enum": ["HOMEWORK", "NOTICE"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "subject", "description", "targetClass", "dateLabel", "teacherRemarks", "entryType", "createdAt", "updatedAt"]
    },
    "HomeworkCompletion": {
      "title": "HomeworkCompletion",
      "description": "Per-user completion status for diary homework.",
      "type": "object",
      "properties": {
        "diaryId": { "type": "string" },
        "completed": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["diaryId", "completed", "updatedAt"]
    }
  },
  "firestore": {
    "/school_config/management": {
      "schema": { "$ref": "#/entities/ManagementConfig" },
      "description": "Single authorized School Management Google account lock."
    },
    "/school_config/payment_account": {
      "schema": { "$ref": "#/entities/PaymentAccount" },
      "description": "Real school bank and UPI settlement account."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Parent or Student Google account link profile."
    },
    "/users/{userId}/homework_completions/{diaryId}": {
      "schema": { "$ref": "#/entities/HomeworkCompletion" },
      "description": "Homework completion markers scoped to userId."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Student directory profiles keyed by Roll Number."
    },
    "/attendance/{studentId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "30-day attendance map per student."
    },
    "/fees/{feeId}": {
      "schema": { "$ref": "#/entities/FeeInvoice" },
      "description": "Monthly fee invoices in Rs and real payment references."
    },
    "/diary/{diaryId}": {
      "schema": { "$ref": "#/entities/DiaryEntry" },
      "description": "Daily school diary homework and notices."
    }
  }
}
